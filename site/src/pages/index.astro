---
import Layout from '../layouts/Layout.astro';
import { HomePage, type HomePageProps } from '../HomePage/HomePage';
import { codeSamples, type CodeSample } from '../HomePage/codeSamples';
import { SearchInput } from '../SearchInput/SearchInput';
import { ColorModeToggle } from '../ColorModeToggle/ColorModeToggle';
import { GitHubStars } from '../GitHubStars/GitHubStars';
import { highlight } from '../markdown/highlight';
import { getDocsPages, groups, toSummary } from '../docs-store';

const pages = (await getDocsPages()).map(toSummary);
const highlightedCodeSamples = Object.fromEntries(
  await Promise.all(
    Object.entries<CodeSample>(codeSamples).map(
      async ([name, { fileName, language = 'tsx', contents, errors }]) => [
        name,
        { fileName, tokens: await highlight(language, contents, { errors }) },
      ],
    ),
  ),
) as HomePageProps['codeSamples'];
---

<Layout>
  <HomePage groups={groups} pages={pages} codeSamples={highlightedCodeSamples}>
    <SearchInput client:load slot="searchInput" />
    <ColorModeToggle client:load slot="colorModeToggle" />
    <GitHubStars client:load slot="gitHubStars" />
  </HomePage>
</Layout>
